{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compilerPath": "/usr/bin/gcc",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/hal/interface",
        "${workspaceFolder}/hal/ports/esp32-wroom-32",
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "cStandard": "c11"
    }
  ],
  "version": 4
}
